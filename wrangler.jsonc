{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "raymi-workers",
  "compatibility_date": "2026-07-13",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "raymi.xyz",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
